From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Wed, 18 Nov 2026 08:48:16 +0000
Subject: [PATCH] fix(amdgpu): an IP discovery binary or table refused for its
 signature names the word read, the signature it should be, its size, offset
 and source, and a register window reading all ones says so, where the refusal
 named neither what was read nor that RCC_CONFIG_MEMSIZE read all ones

---
 drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
index 2b2c6795f20b681998f9dc3ac7392874541432ac..235e9c04d4755ec02951e521ab031610113776a5 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
@@ -287,8 +287,12 @@ static int amdgpu_discovery_get_tmr_info(struct amdgpu_device *adev,
 	}
 
 	vram_size = RREG32(mmRCC_CONFIG_MEMSIZE);
-	if (vram_size == U32_MAX)
+	if (vram_size == U32_MAX) {
+		dev_err(adev->dev,
+			"ip discovery: RCC_CONFIG_MEMSIZE (0x%x) reads all ones: the GPU does not answer\n",
+			mmRCC_CONFIG_MEMSIZE * 4);
 		return -ENXIO;
+	}
 	else if (!vram_size)
 		*is_tmr_in_sysmem = true;
 	else
@@ -651,7 +655,9 @@ static int amdgpu_discovery_table_check(struct amdgpu_device *adev,
 
 	if (check_table && offset) {
 		if (act_val != exp_val) {
-			dev_err(adev->dev, "invalid ip discovery %s signature\n", table_name);
+			dev_err(adev->dev,
+				"invalid ip discovery %s signature: 0x%08x at offset 0x%x where it is 0x%08x\n",
+				table_name, act_val, offset, exp_val);
 			return -EINVAL;
 		}
 
@@ -701,7 +707,11 @@ static int amdgpu_discovery_init(struct amdgpu_device *adev)
 	/* check the ip discovery binary signature */
 	if (!amdgpu_discovery_verify_binary_signature(discovery_bin)) {
 		dev_err(adev->dev,
-			"get invalid ip discovery binary signature\n");
+			"get invalid ip discovery binary signature: read 0x%08x where it is 0x%08x, %u bytes from %s at 0x%llx\n",
+			le32_to_cpu(((struct binary_header *)discovery_bin)->binary_signature),
+			BINARY_SIGNATURE, adev->discovery.size,
+			fw_name ? fw_name : is_tmr_in_sysmem ? "system memory" : "VRAM",
+			adev->discovery.offset);
 		r = -EINVAL;
 		goto out;
 	}
